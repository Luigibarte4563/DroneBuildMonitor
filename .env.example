# Gmail SMTP Configuration
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords (select "Mail")
# 3. Copy the 16-character password (spaces allowed)

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional
MAIL_FROM_NAME=DroneBuild Monitor
MAIL_REPLY_TO=hello@dronebuild.ph
MAIL_BCC=owner@example.com
PORT=4173