# Copy this file to .env and fill it in. Never commit .env.
# Gmail needs 2-Step Verification on, then an App Password (not the account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=DroneBuild Monitor
# Where replies go. Defaults to GMAIL_USER when empty.
MAIL_REPLY_TO=
# Optional: extra address that gets an owner copy of every booking email (the site owner). The Gmail sender always gets a copy too.
MAIL_BCC=
PORT=4173
